NAME = TBAI_anion.inp.run
|  1> ! B3LYP D3BJ def2-TZVP SP
|  2> 
|  3> %maxcore 4000
|  4> 
|  5> %pal
|  6>     nprocs 1
|  7> end
|  8> 
|  9> %output
| 10>     Print[ P_OrbEn ] 2        # full orbital energies -> HOMO/LUMO
| 11>     Print[ P_MOs ] 1          # MO coefficients
| 12>     Print[ P_Mayer ] 1        # Mayer bond orders
| 13>     Print[ P_Hirshfeld ] 1    # Hirshfeld charges
| 14> end
| 15> 
| 16> * xyz -1 1
| 17> I      0.000000     0.000000     0.000000
| 18> *
| 19> 
| 20>                          ****END OF INPUT****
