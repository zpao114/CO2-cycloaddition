# =============================================================================
# CO2 Cycloaddition ML Pipeline — .gitignore
# Strategy: keep important large files (.out, .property.txt, .log, .hess)
# that are DFT/xtb computation results; drop only true binary intermediates.
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/

# xTB runtime stdout (regenerated every run)
*.xtb.stdout
*.xtb.err

# Environment / OS / IDE
.env
.env.local
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.ipynb
*.ipynb_checkpoints/

# =============================================================================
# Pipeline run logs (NOT computation logs — these are pipeline orchestration)
# =============================================================================
logs/
# Per-directory *.log files inside tools/ (xtb/ORCA run outputs)
tools/*.log

# Legacy/redundant copy of molecular_structures (not referenced by any code)
dft_validation/xyz_structures/
# *Computational* .log/.out/.property.txt/.hess are kept (DFT results).

# =============================================================================
# Cached intermediates (regenerated by pipeline)
# =============================================================================
*.npy
*.npz
*.pkl
*.joblib
*.pt
*.pth
*.cache
.cache/
mol_mgr_cache.json
pcl_drfp_latent.npy.meta.json

# =============================================================================
# Generated outputs (results/ - regenerated by pipeline)
# =============================================================================
# Top-level results/ and results_*/ are pipeline-generated ML results.
# dft_validation/results/ is NOT touched (those are DFT analysis summaries).
/results/
/results_*/

# =============================================================================
# DFT / xtb / ORCA true binary intermediates
# (kept: .inp, .xyz, .out, .property.txt, .log, .hess, _trj.xyz)
# (dropped: *.opt — Hessian binaries with local paths)
# =============================================================================
*.opt
*.gbw
*.densities
*.densitiesinfo
*.ges
*.dos
*.prop
*.bas0
*.bas1
*.bas2
*.bas3
*.bas4
*.bas5
*.scfgrad.inp
*.smd.grd
*.diisao.tmp.*
*.diise.tmp.*
*.diist.tmp.*
*.cpscf*
*.cpcm.tmp
*.cpcm_achol.tmp
*.citations.tmp
*.shark_grid.tmp
*.C0.tmp
*.E.tmp
*.F.tmp
*.G.tmp
*.H.tmp
*.K.tmp
*.P.tmp
*.S.tmp
*.T.tmp
*.V.tmp
*.EIJ.tmp
*.FAO.tmp
*.FMO.tmp
*.PINP.tmp
*.POLD.tmp
*.PAUX.tmp
*.PDAT.tmp
*.SM12.tmp
*.SP12.tmp
*.SHARK*.tmp
*.SQRTVJ.tmp
*.VAUXJ.tmp
*.VCDJ.tmp
*.VXC.tmp
*.ROT.tmp
*.grid.tmp
*.int.tmp
*.inthess.tmp
*.en.tmp
*.gpot*.tmp
*.opot*.tmp
*.grho*.tmp
*.orho*.tmp
*.ginp.tmp
*.exc0.tmp
*.eps.tmp
*.cpcm
*.cpcm.tmp
*.smd
*.vcpcm.tmp
*.epsdata.tmp
*.libaf*
xtboptok
xtbopt.xyz
xtblast.xyz
xtbrestart
xtbtopo.mol
charges
wbo

# =============================================================================
# Visualization scripts (figures are uploaded, code is not)
# =============================================================================
src/visualization/

# =============================================================================
# Personal / backup / debug files
# =============================================================================
*.bak
*.bak_*
*_backup*
*_old*
*_new*
*.tmp
*.TMP
README.md.bak
# Loose debug-only files at repo root
/_verify*.py
/_check*.py
/_scan*.py
/_final*.py
/verify_pcl_ae_latent.py
/snapshot*.json

# Personal files
朱子健.docx
~$*.docx

# ORCA scheduler hostnames (expose local machine names)
*.hostnames

# Local user-specific configs (use .example templates instead)
configs/project.yaml

# Hooks (local-only)
scripts/hooks/

# =============================================================================
# Docs / papers / references (NOT GitHub)
# =============================================================================
references/
docs/paper/
docs/pipeline_notes/
paper_text/

# =============================================================================
# Data files (raw Reaxys; intermediate bootstrap stats)
# =============================================================================
# Raw Reaxys dump (private source data)
data/raw/

# Intermediate processed CSVs (regenerated by pipeline)
data/processed/bootstrap_*.csv
data/processed/ML_*.csv

# External baselines (regenerated)
data/external/